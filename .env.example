# Gemini API Key (Required for /ask question answering)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector DB Connection (Optional - defaults to embedded local storage if unset)
# For Docker Compose / production server mode, use: http://qdrant:6333 or http://localhost:6333
QDRANT_URL=

# CORS Allowed Origins (Optional - comma-separated list of origins, defaults to "*")
CORS_ORIGINS=*
